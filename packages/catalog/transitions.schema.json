{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoMe92/moviemakery2k/packages/catalog/transitions.schema.json",
  "title": "moviemakerY2K – Übergangskatalog",
  "type": "object",
  "required": ["schemaVersion", "transitions"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/transition" }
    }
  },
  "$defs": {
    "transition": {
      "type": "object",
      "required": ["id", "name", "shader", "defaultDuration", "params", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "shader": {
          "description": "Dateiname in packages/shaders/transitions/",
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.glsl$"
        },
        "defaultDuration": {
          "description": "Sekunden; Bereich und Raster wie im Projektmodell",
          "type": "number",
          "minimum": 0.25,
          "maximum": 5,
          "multipleOf": 0.25
        },
        "params": {
          "description": "Wird 1:1 zu `uniform float <name>` im Shader",
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
          "additionalProperties": { "type": "number" }
        },
        "source": {
          "type": "object",
          "required": ["kind", "ref"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["wmm2x-xml", "smpte"] },
            "ref": { "type": "string", "minLength": 1 },
            "estimated": {
              "description": "Parameter, deren Wert nicht belegt, sondern geschätzt ist [E]",
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
