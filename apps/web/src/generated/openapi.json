{
  "components": {
    "schemas": {
      "ApiError": {
        "additionalProperties": false,
        "description": "An error of the backend: stable code, params and English message (design.md D5).",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode",
            "description": "Stable dotted error code, e.g. `export.emptyProject`"
          },
          "message": {
            "description": "English message; shown when the code is unknown",
            "title": "Message",
            "type": "string"
          },
          "params": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ]
            },
            "description": "Values the message is built from",
            "title": "Params",
            "type": "object"
          }
        },
        "required": [
          "code",
          "params",
          "message"
        ],
        "title": "ApiError",
        "type": "object"
      },
      "ApiErrorIssue": {
        "additionalProperties": false,
        "description": "One rule violation of a request body, with the position of the offending value.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode",
            "description": "Stable dotted error code, e.g. `export.emptyProject`"
          },
          "loc": {
            "description": "Position in the body, e.g. [\"body\", \"slides\", 2]",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "message": {
            "description": "English message; shown when the code is unknown",
            "title": "Message",
            "type": "string"
          },
          "params": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ]
            },
            "description": "Values the message is built from",
            "title": "Params",
            "type": "object"
          }
        },
        "required": [
          "code",
          "params",
          "message",
          "loc"
        ],
        "title": "ApiErrorIssue",
        "type": "object"
      },
      "ApiErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ApiError"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ApiErrorResponse",
        "type": "object"
      },
      "ApiErrorWithIssues": {
        "additionalProperties": false,
        "description": "An error that collects several rule violations (`project.invalid`).",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode",
            "description": "Stable dotted error code, e.g. `export.emptyProject`"
          },
          "issues": {
            "items": {
              "$ref": "#/components/schemas/ApiErrorIssue"
            },
            "title": "Issues",
            "type": "array"
          },
          "message": {
            "description": "English message; shown when the code is unknown",
            "title": "Message",
            "type": "string"
          },
          "params": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ]
            },
            "description": "Values the message is built from",
            "title": "Params",
            "type": "object"
          }
        },
        "required": [
          "code",
          "params",
          "message",
          "issues"
        ],
        "title": "ApiErrorWithIssues",
        "type": "object"
      },
      "ApiValidationResponse": {
        "description": "422 body: an `ApiError` or FastAPI's native list.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ApiError"
              },
              {
                "items": {
                  "$ref": "#/components/schemas/RequestValidationIssue"
                },
                "type": "array"
              }
            ],
            "title": "Detail"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ApiValidationResponse",
        "type": "object"
      },
      "Body_upload_media_api_media_post": {
        "properties": {
          "files": {
            "description": "Image files (JPEG, PNG, WebP)",
            "items": {
              "contentMediaType": "application/octet-stream",
              "type": "string"
            },
            "title": "Files",
            "type": "array"
          }
        },
        "required": [
          "files"
        ],
        "title": "Body_upload_media_api_media_post",
        "type": "object"
      },
      "ErrorCode": {
        "description": "All stable error codes; part of the API contract as an OpenAPI enum (design.md D4).\n\nNever rename a code, add a new one instead.",
        "enum": [
          "media.notFound",
          "media.tooManyFiles",
          "media.unsupportedType",
          "media.tooLarge",
          "media.tooManyPixels",
          "media.inUseByExport",
          "project.slideDuration.outOfRange",
          "project.slideDuration.offGrid",
          "project.transitionDuration.outOfRange",
          "project.transitionDuration.offGrid",
          "project.invalid",
          "project.slide.duplicateId",
          "project.slide.unknownMedia",
          "project.slide.firstHasTransition",
          "project.slide.unknownTransition",
          "export.notFound",
          "export.emptyProject",
          "export.missingMedia",
          "export.busy",
          "export.notReady",
          "export.fileName.empty",
          "export.fileName.invalidChars",
          "export.fileName.controlChars",
          "export.fileName.invalid",
          "export.fileName.tooLong",
          "export.glUnavailable",
          "export.noImages",
          "export.ffmpegMissing",
          "export.ffmpegStartFailed",
          "export.ffmpegInputClosed",
          "export.ffmpegInputClosedEarly",
          "export.ffmpegFailed",
          "export.renderFailed",
          "export.saveFailed",
          "export.unexpected"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ExportJob": {
        "additionalProperties": false,
        "properties": {
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "errorCode": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              },
              {
                "type": "null"
              }
            ],
            "description": "Stable error code when `failed` (design.md D3), otherwise null"
          },
          "errorParams": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ]
            },
            "description": "Values of the error message; empty without error",
            "title": "Errorparams",
            "type": "object"
          },
          "fileName": {
            "description": "File name without extension",
            "title": "Filename",
            "type": "string"
          },
          "id": {
            "pattern": "^[0-9a-f]{32}$",
            "title": "Id",
            "type": "string"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "English error message when `failed`, otherwise null",
            "title": "Message"
          },
          "profile": {
            "$ref": "#/components/schemas/ExportProfile"
          },
          "progress": {
            "description": "Progress 0..1",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Progress",
            "type": "number"
          },
          "status": {
            "$ref": "#/components/schemas/ExportStatus"
          }
        },
        "required": [
          "id",
          "status",
          "progress",
          "profile",
          "fileName",
          "errorCode",
          "errorParams",
          "message",
          "createdAt"
        ],
        "title": "ExportJob",
        "type": "object"
      },
      "ExportListResponse": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "description": "All known exports, oldest first",
            "items": {
              "$ref": "#/components/schemas/ExportJob"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "ExportListResponse",
        "type": "object"
      },
      "ExportProfile": {
        "description": "Output profile of the export; the value is the name in the API contract.",
        "enum": [
          "high",
          "small"
        ],
        "title": "ExportProfile",
        "type": "string"
      },
      "ExportRequest": {
        "additionalProperties": false,
        "properties": {
          "fileName": {
            "description": "Requested file name without extension; `.mp4` is appended on download. Not allowed: / \\ : * ? \" < > | and control characters.",
            "examples": [
              "My Movie"
            ],
            "title": "Filename",
            "type": "string"
          },
          "profile": {
            "$ref": "#/components/schemas/ExportProfile",
            "default": "high",
            "description": "`high` = 960x720 (default), `small` = 640x480; both 30 fps"
          }
        },
        "required": [
          "fileName"
        ],
        "title": "ExportRequest",
        "type": "object"
      },
      "ExportStatus": {
        "enum": [
          "queued",
          "running",
          "done",
          "failed",
          "cancelled"
        ],
        "title": "ExportStatus",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "ffmpeg": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ffmpeg"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "ffmpeg"
        ],
        "title": "Health",
        "type": "object"
      },
      "MediaDeleteResponse": {
        "additionalProperties": false,
        "properties": {
          "project": {
            "$ref": "#/components/schemas/Project"
          }
        },
        "required": [
          "project"
        ],
        "title": "MediaDeleteResponse",
        "type": "object"
      },
      "MediaItem": {
        "additionalProperties": false,
        "properties": {
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "filename": {
            "description": "Original file name, for display only",
            "title": "Filename",
            "type": "string"
          },
          "height": {
            "description": "Height after EXIF orientation",
            "title": "Height",
            "type": "integer"
          },
          "id": {
            "pattern": "^[0-9a-f]{32}$",
            "title": "Id",
            "type": "string"
          },
          "previewUrl": {
            "title": "Previewurl",
            "type": "string"
          },
          "thumbnailUrl": {
            "title": "Thumbnailurl",
            "type": "string"
          },
          "width": {
            "description": "Width after EXIF orientation",
            "title": "Width",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "filename",
          "width",
          "height",
          "createdAt",
          "thumbnailUrl",
          "previewUrl"
        ],
        "title": "MediaItem",
        "type": "object"
      },
      "MediaListResponse": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "description": "All media in import order",
            "items": {
              "$ref": "#/components/schemas/MediaItem"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "MediaListResponse",
        "type": "object"
      },
      "MediaUploadFailure": {
        "additionalProperties": false,
        "properties": {
          "errorCode": {
            "$ref": "#/components/schemas/ErrorCode",
            "description": "Stable error code (design.md D3, D4); one of media.unsupportedType, media.tooLarge, media.tooManyPixels"
          },
          "errorParams": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ]
            },
            "description": "Values of the message",
            "title": "Errorparams",
            "type": "object"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "message": {
            "description": "English message",
            "title": "Message",
            "type": "string"
          },
          "ok": {
            "const": false,
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "filename",
          "ok",
          "errorCode",
          "errorParams",
          "message"
        ],
        "title": "MediaUploadFailure",
        "type": "object"
      },
      "MediaUploadResponse": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/MediaUploadSuccess"
                },
                {
                  "$ref": "#/components/schemas/MediaUploadFailure"
                }
              ]
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "MediaUploadResponse",
        "type": "object"
      },
      "MediaUploadSuccess": {
        "additionalProperties": false,
        "properties": {
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "item": {
            "$ref": "#/components/schemas/MediaItem"
          },
          "ok": {
            "const": true,
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "filename",
          "ok",
          "item"
        ],
        "title": "MediaUploadSuccess",
        "type": "object"
      },
      "Project": {
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "const": 1,
            "title": "Schemaversion",
            "type": "integer"
          },
          "slides": {
            "items": {
              "$ref": "#/components/schemas/Slide"
            },
            "maxItems": 1000,
            "title": "Slides",
            "type": "array"
          }
        },
        "required": [
          "schemaVersion",
          "slides"
        ],
        "title": "Project",
        "type": "object"
      },
      "ProjectValidationResponse": {
        "description": "422 body of PUT /api/project: reference errors or FastAPI's native list.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ApiErrorWithIssues"
              },
              {
                "items": {
                  "$ref": "#/components/schemas/RequestValidationIssue"
                },
                "type": "array"
              }
            ],
            "title": "Detail"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ProjectValidationResponse",
        "type": "object"
      },
      "RequestValidationIssue": {
        "description": "One entry of FastAPI's native 422 list. For rule violations of this API,\n`type` is an error code from `ERRORS`, `ctx` its params and `msg` the message.",
        "properties": {
          "ctx": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ctx"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "RequestValidationIssue",
        "type": "object"
      },
      "Slide": {
        "additionalProperties": false,
        "properties": {
          "duration": {
            "description": "Display duration in seconds",
            "maximum": 60.0,
            "minimum": 0.5,
            "multipleOf": 0.25,
            "title": "Duration",
            "type": "number"
          },
          "id": {
            "description": "Assigned by the client, unique within the project",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Id",
            "type": "string"
          },
          "mediaId": {
            "description": "ID of a medium from /api/media",
            "title": "Mediaid",
            "type": "string"
          },
          "transitionIn": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TransitionRef"
              },
              {
                "type": "null"
              }
            ],
            "description": "Incoming transition from the previous element; always null for the first"
          }
        },
        "required": [
          "id",
          "mediaId",
          "duration",
          "transitionIn"
        ],
        "title": "Slide",
        "type": "object"
      },
      "Transition": {
        "additionalProperties": false,
        "properties": {
          "defaultDuration": {
            "description": "Seconds",
            "maximum": 5.0,
            "minimum": 0.25,
            "multipleOf": 0.25,
            "title": "Defaultduration",
            "type": "number"
          },
          "id": {
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "title": "Id",
            "type": "string"
          },
          "names": {
            "$ref": "#/components/schemas/TransitionNames"
          },
          "params": {
            "description": "Becomes `uniform float <name>` in the shader, 1:1",
            "patternProperties": {
              "^[a-z][A-Za-z0-9]*$": {
                "type": "number"
              }
            },
            "title": "Params",
            "type": "object"
          },
          "shader": {
            "description": "File name in packages/shaders/transitions/",
            "pattern": "^[a-z0-9-]+\\.glsl$",
            "title": "Shader",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/TransitionSource"
          }
        },
        "required": [
          "id",
          "names",
          "shader",
          "defaultDuration",
          "params",
          "source"
        ],
        "title": "Transition",
        "type": "object"
      },
      "TransitionCatalog": {
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "const": 1,
            "title": "Schemaversion",
            "type": "integer"
          },
          "transitions": {
            "items": {
              "$ref": "#/components/schemas/Transition"
            },
            "minItems": 1,
            "title": "Transitions",
            "type": "array"
          }
        },
        "required": [
          "schemaVersion",
          "transitions"
        ],
        "title": "TransitionCatalog",
        "type": "object"
      },
      "TransitionNames": {
        "additionalProperties": false,
        "description": "Display name per UI language; both languages are required.",
        "properties": {
          "de": {
            "minLength": 1,
            "title": "De",
            "type": "string"
          },
          "en": {
            "minLength": 1,
            "title": "En",
            "type": "string"
          }
        },
        "required": [
          "de",
          "en"
        ],
        "title": "TransitionNames",
        "type": "object"
      },
      "TransitionRef": {
        "additionalProperties": false,
        "properties": {
          "duration": {
            "description": "Target duration of the transition in seconds",
            "maximum": 5.0,
            "minimum": 0.25,
            "multipleOf": 0.25,
            "title": "Duration",
            "type": "number"
          },
          "transitionId": {
            "description": "ID from the transition catalog",
            "title": "Transitionid",
            "type": "string"
          }
        },
        "required": [
          "transitionId",
          "duration"
        ],
        "title": "TransitionRef",
        "type": "object"
      },
      "TransitionSource": {
        "additionalProperties": false,
        "properties": {
          "estimated": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Parameters whose value is not documented but estimated [E]",
            "title": "Estimated"
          },
          "kind": {
            "enum": [
              "wmm2x-xml",
              "smpte"
            ],
            "title": "Kind",
            "type": "string"
          },
          "ref": {
            "minLength": 1,
            "title": "Ref",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "ref"
        ],
        "title": "TransitionSource",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "moviemakerY2K",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/catalog/transitions": {
      "get": {
        "operationId": "list_transitions_api_catalog_transitions_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransitionCatalog"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Transitions",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/exports": {
      "get": {
        "description": "All known exports (since the backend started), oldest first.",
        "operationId": "list_exports_api_exports_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExportListResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Exports",
        "tags": [
          "exports"
        ]
      },
      "post": {
        "description": "Starts an export of the saved project as it is right now.\n\nLater changes to the project do not affect this export.\nAt most one export runs at a time; a second start returns 409.",
        "operationId": "start_export_api_exports_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExportJob"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
